# required database path; dev server falls back to this value when DATABASE_URL is unset
DATABASE_URL="file:./dev.db"

# provider mode: api-key | oauth-proxy
WRITER_PROVIDER="oauth-proxy"

# OpenAI-compatible endpoint
OPENAI_BASE_URL="http://127.0.0.1:10531/v1"
OPENAI_API_KEY="dummy-for-local-proxy"
WRITER_MODEL="gpt-5.5"
WRITER_REASONING_EFFORT="xhigh"
WRITER_MODEL_OPTIONS="gpt-5.3,gpt-5.2"

# optional: Trend Scout v2 external signals, server-only
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# optional: Community Radar public API collectors, server-only
GITHUB_TOKEN=""
REDDIT_BEARER_TOKEN=""
REDDIT_SUBREDDIT_WHITELIST="LocalLLaMA,ChatGPTCoding,OpenAI"
STACKEXCHANGE_SITE="stackoverflow"
STACK_EXCHANGE_KEY=""
